// preview context menu (0x004125e8)
CONTEXT MENU
BEGIN
    POPUP "context"
    BEGIN
        POPUP "拡大表示"
        BEGIN
            MENUITEM "25%",         9200
            MENUITEM "50%",         9201
            MENUITEM "100%",        9202
            MENUITEM "200%",        9203
            MENUITEM "300%",        9204
            MENUITEM "400%",        9205
            MENUITEM "WindowSize",  9206
        END
        MENUITEM SEPARATOR
        MENUITEM "画像をコピー",                         1020
        MENUITEM "画像を貼り付け",                       5117
        MENUITEM "クリップボードにコピー",               1026
        MENUITEM "クリップボードから貼り付け",           5123
        MENUITEM "クリップボードに出力イメージをコピー", 1070
        MENUITEM "選択範囲の切り出し",                   5143
        MENUITEM "選択範囲の削除",                       5101
        MENUITEM SEPARATOR
        MENUITEM "元に戻す",                             5147
        MENUITEM "すべてを選択",                         5112
        MENUITEM SEPARATOR
        MENUITEM "マークする",                           5130
    END
END

CONTEXT_EN MENU
BEGIN
    POPUP "context"
    BEGIN
        POPUP "Zoom"
        BEGIN
            MENUITEM "25%",         9200
            MENUITEM "50%",         9201
            MENUITEM "100%",        9202
            MENUITEM "200%",        9203
            MENUITEM "300%",        9204
            MENUITEM "400%",        9205
            MENUITEM "WindowSize",  9206
        END
        MENUITEM SEPARATOR
        MENUITEM "Copy Frame Image",                1020
        MENUITEM "Paste Frame Image",               5117
        MENUITEM "Copy to Clipboard",               1026
        MENUITEM "Paste from Clipboard",            5123
        MENUITEM "Copy Output Image to Clipboard",  1070
        MENUITEM "Trim to Selection",               5143
        MENUITEM "Delete Selection",                5101
        MENUITEM SEPARATOR
        MENUITEM "Undo",                            5147
        MENUITEM "Select All",                      5112
        MENUITEM SEPARATOR
        MENUITEM "Mark Frame",                      5130
    END
END

